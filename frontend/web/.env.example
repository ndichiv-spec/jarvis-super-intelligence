# JARVIS Frontend Environment Configuration
# Copy this file to .env and configure as needed

# API Configuration
# Keep browser API calls same-origin so HttpOnly auth cookies are sent reliably.
# Next.js rewrites /api/v1/* and /api/chat* to the backend in local development.
# Set JARVIS_API_INTERNAL_URL on the server when the backend is not on 127.0.0.1.
NEXT_PUBLIC_API_URL=

# WebSocket Configuration
# Use the same hostname as the frontend so browser auth cookies remain same-site.
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# Socket URL (alternative, for socket.io)
NEXT_PUBLIC_SOCKET_URL=http://localhost:8000

# Application Settings
NEXT_PUBLIC_APP_NAME=JARVIS AI
NEXT_PUBLIC_APP_VERSION=3.0.0

# Environment
# Options: development, production, test
NEXT_PUBLIC_ENVIRONMENT=development

# Feature Flags
NEXT_PUBLIC_ENABLE_ANALYTICS=false
NEXT_PUBLIC_ENABLE_DEV_TOOLS=true

# Request Timeout (milliseconds)
NEXT_PUBLIC_REQUEST_TIMEOUT=30000

# WebSocket Reconnection Settings
NEXT_PUBLIC_WS_RECONNECT_ATTEMPTS=10
NEXT_PUBLIC_WS_RECONNECT_INTERVAL=3000