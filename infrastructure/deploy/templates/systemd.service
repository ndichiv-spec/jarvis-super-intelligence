[Unit]
Description=JARVIS Super AI
Documentation=https://jarvis.ai/docs
After=network.target postgresql.service redis.service
Wants=postgresql.service redis.service

[Service]
Type=simple
User=jarvis
Group=jarvis
WorkingDirectory=/opt/jarvis
EnvironmentFile=/opt/jarvis/.env
ExecStartPre=/opt/jarvis/venv/bin/python -m infrastructure.startup.cli
ExecStart=/opt/jarvis/venv/bin/uvicorn api.main:app --host 0.0.0.0 --port 8000 --workers 4 --proxy-headers --forwarded-allow-ips=*
ExecStop=/bin/kill -s TERM $MAINPID
ExecReload=/bin/kill -s HUP $MAINPID
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=jarvis

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
ReadWritePaths=/opt/jarvis/data /opt/jarvis/logs

[Install]
WantedBy=multi-user.target
