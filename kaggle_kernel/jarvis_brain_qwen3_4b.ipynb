    "# %% [markdown]\n",
    "# ## 2. Authentication\n",
    "# Configure lowercase env-var name == Kaggle Secrets variable (JARVIS_HF_TOKEN).\n",
    "import os, json, time\n",
    "HF_TOKEN = os.environ.get('JARVIS_HF_TOKEN') or os.environ.get('HF_TOKEN') or ''\n",
    "if HF_TOKEN:\n",
    "    os.environ['HF_TOKEN'] = HF_TOKEN\n",
    "    print('HF_TOKEN: configured ({} chars)'.format(len(HF_TOKEN)))\n",
    "else:\n",
    "    print('HF_TOKEN: NOT set — set a Kaggle Secret JARVIS_HF_TOKEN and re-run.')\n",
    "\n",
    "# Optional user name for \"JARVIS\" HF namespace.\n",
    "HF_NS = os.environ.get('JARVIS_HF_NS', '')  # e.g. videlisndichi\n",
    "MODEL_ID = 'Qwen/Qwen3-4B'\n",
    "REVISION = '1cfa9a7208912126459214e8b04321603b3df60c'  # pinned, immutable\n",
    "MODEL_OWNER = 'jarvis-brain-qwen3-4b'                 # release repo name\n",
    "print('MODEL  :', MODEL_ID, 'r/', REVISION[:8])"
   ]
