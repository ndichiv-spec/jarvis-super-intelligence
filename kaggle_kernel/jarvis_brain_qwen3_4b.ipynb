   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# %% [markdown]\n",
    "# ## 1. Environment audit — hardware reality\n",
    "# Do NOT assume T4/P100. Print the ACTUAL accelerator.\n",
    "import platform\n",
    "import psutil\n",
    "import shutil\n",
    "import subprocess\n",
    "import torch\n",
    "import transformers\n",
    "import accelerate\n",
    "import torch\n",
    "print('hostname     :', platform.node())\n",
    "print('python       :', platform.python_version())\n",
    "print('torch        :', torch.__version__)\n",
    "print('transformers :', transformers.__version__)\n",
    "print('accelerate   :', getattr(accelerate, '__version__', '?'))\n",
    "print('cuda built   :', torch.version.cuda)\n",
    "print('cuda avail   :', torch.cuda.is_available())\n",
    "if torch.cuda.is_available():\n",
    "    for i in range(torch.cuda.device_count()):\n",
    "        p = torch.cuda.get_device_properties(i)\n",
    "        print(f'  gpu[{i}]: {p.name} | {p.total_memory/1e9:.1f} GB VRAM | cuda {torch.version.cuda}')\n",
    "else:\n",
    "    print('  no CUDA GPU detected')\n",
    "print('cpu cores    :', psutil.cpu_count(logical=False))\n",
    "print('cpu threads  :', psutil.cpu_count(logical=True))\n",
    "print('system RAM   : {:.1f} GB'.format(psutil.virtual_memory().total/1e9))\n",
    "print('disk free    : {:.1f} GB'.format(shutil.disk_usage('/kaggle').free/1e9))\n",
    "print('bf16 support :', torch.cuda.is_bf16_supported() if torch.cuda.is_available() else 'n/a (cpu)')"
   ]
