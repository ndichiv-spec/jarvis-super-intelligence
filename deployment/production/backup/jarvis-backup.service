[Unit]
Description=Create and verify JARVIS production backups
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
User=root
Environment=BACKUP_DIR=/var/lib/jarvis-backups
Environment=RETENTION_DAYS=30
StateDirectory=jarvis-backups
StateDirectoryMode=0700
TimeoutStartSec=6h
ExecStart=/usr/bin/bash /opt/jarvis/deployment/production/backup/backup.sh
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/jarvis-backups
