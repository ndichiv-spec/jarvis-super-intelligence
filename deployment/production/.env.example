# Copy to .env in this directory and set real values. Never commit that copy.
JARVIS_DOMAIN=
JARVIS_SCHEME=https
JARVIS_PUBLIC_PORT=443
JARVIS_HTTP_PORT=80
JARVIS_BASE_PATH=/
JARVIS_API_PATH=/api
JARVIS_WS_PATH=/ws
JARVIS_ALERT_WEBHOOK_URL=
ACME_EMAIL=
JARVIS_ADMIN_EMAIL=
JARVIS_VERSION=
PREVIOUS_JARVIS_VERSION=
GIT_SHA=
BUILD_TIME=
DEPLOYMENT_ID=
POSTGRES_DB=jarvis_db
POSTGRES_USER=jarvis
JARVIS_IMAGE_PREFIX=ghcr.io/ndichiv-spec/jarvis-super-intelligence

# Absolute files on the server, outside the Git working tree, owner-readable.
POSTGRES_PASSWORD_FILE_SOURCE=/etc/jarvis/secrets/postgres-password
REDIS_CACHE_PASSWORD_FILE_SOURCE=/etc/jarvis/secrets/redis-cache-password
REDIS_QUEUE_PASSWORD_FILE_SOURCE=/etc/jarvis/secrets/redis-queue-password
JARVIS_SECRET_KEY_FILE_SOURCE=/etc/jarvis/secrets/jarvis-secret-key
JARVIS_ADMIN_PASSWORD_FILE_SOURCE=/etc/jarvis/secrets/jarvis-admin-password
OPENAI_API_KEY_FILE_SOURCE=/etc/jarvis/secrets/openai-api-key
OAUTH_CLIENTS_FILE_SOURCE=/etc/jarvis/secrets/oauth-clients.json
DATABASE_URL_FILE_SOURCE=/etc/jarvis/secrets/database-url
REDIS_CACHE_URL_FILE_SOURCE=/etc/jarvis/secrets/redis-cache-url
CELERY_BROKER_URL_FILE_SOURCE=/etc/jarvis/secrets/celery-broker-url
ALERT_WEBHOOK_SECRET_FILE_SOURCE=/etc/jarvis/secrets/alert-webhook-secret
