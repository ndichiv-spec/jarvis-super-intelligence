# Copy to deployment/production/.env and replace every example value.
# Never commit the resulting .env or any referenced secret files.
JARVIS_DOMAIN=replace-with-real-domain.example.invalid
JARVIS_SCHEME=https
JARVIS_PUBLIC_PORT=443
JARVIS_HTTP_PORT=80
JARVIS_BASE_PATH=/
JARVIS_API_PATH=/api
JARVIS_WS_PATH=/ws
JARVIS_ALERT_WEBHOOK_URL=
ACME_EMAIL=replace-with-operations-email

JARVIS_IMAGE_PREFIX=ghcr.io/ndichiv-spec/jarvis-super-intelligence
JARVIS_VERSION=sha-replace-with-immutable-commit-tag
PREVIOUS_JARVIS_VERSION=sha-replace-with-previous-immutable-tag
GIT_SHA=replace-with-40-character-commit-sha
BUILD_TIME=replace-with-UTC-image-build-time
DEPLOYMENT_ID=initial-deployment
JARVIS_ADMIN_EMAIL=replace-with-admin-email
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_FROM=
SMTP_USE_SSL=false

POSTGRES_DB=jarvis_db
POSTGRES_USER=jarvis

# Create these files outside the repository, restrict them to the host
# administrator (0600), and replace these paths with their absolute paths.
POSTGRES_PASSWORD_FILE_SOURCE=/etc/jarvis/secrets/postgres_password
REDIS_CACHE_PASSWORD_FILE_SOURCE=/etc/jarvis/secrets/redis_cache_password
REDIS_QUEUE_PASSWORD_FILE_SOURCE=/etc/jarvis/secrets/redis_queue_password
JARVIS_SECRET_KEY_FILE_SOURCE=/etc/jarvis/secrets/jarvis_secret_key
JARVIS_ADMIN_PASSWORD_FILE_SOURCE=/etc/jarvis/secrets/jarvis_admin_password
OPENAI_API_KEY_FILE_SOURCE=/etc/jarvis/secrets/openai_api_key
OAUTH_CLIENTS_FILE_SOURCE=/etc/jarvis/secrets/oauth_clients.json
DATABASE_URL_FILE_SOURCE=/etc/jarvis/secrets/database_url
REDIS_CACHE_URL_FILE_SOURCE=/etc/jarvis/secrets/redis_cache_url
CELERY_BROKER_URL_FILE_SOURCE=/etc/jarvis/secrets/celery_broker_url
ALERT_WEBHOOK_SECRET_FILE_SOURCE=/etc/jarvis/secrets/alert_webhook_secret
SMTP_PASSWORD_FILE_SOURCE=/etc/jarvis/secrets/smtp_password
