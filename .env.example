# JARVIS OAuth credentials.
#
# Copy this file to ".env" (NOT committed) and fill in the values, then restart
# the platform via:  powershell -ExecutionPolicy Bypass -File start_all.ps1
# (stop the existing JARVIS platform process on :8000 first so it restarts with
# the new env). start_all.ps1 sources this .env, builds the internal
# JARVIS_OAUTH_CLIENTS JSON, and the platform uses it for real OAuth.
#
# OS environment variables take precedence over these values if both are set.
#
# Register ONE OAuth App per provider (classic OAuth app) with this redirect URI:
#   http://localhost:8000/api/v1/extensions/oauth/callback/<ext_id>
# (the URL JARVIS redirects the provider back to after you sign in).


# --- Platform admin identity (spec §7/§16) ---
# The seeded "first login" admin signs in with this email. The platform does NOT
# auto-create any real production org email or phone-number identity -- the admin
# email is explicit configuration so sign-in ownership is always auditable.
#
#   Development (default): JARVIS_ENV unset -> admin@jarvis.local is used as a
#   convenient first-sign-in placeholder if JARVIS_ADMIN_EMAIL is omitted.
#
#   Production:  set JARVIS_ENV=production AND a real JARVIS_ADMIN_EMAIL (e.g. an
#   org service account such as admin@example.com). The platform REFUSES
#   to start with a clear error if production mode is selected without it -- it
#   will never fall back to the admin@jarvis.local placeholder in production.
#
# IMPORTANT: JARVIS_ADMIN_EMAIL identifies the platform administrator only.
# It is NOT an OAuth credential, password, or API key. Gmail/Outlook access
# uses the separate OAuth connector flow. Never expose this email in
# logs, telemetry, API responses, or frontend bundles unless intentionally
# required by the Admin Console.
JARVIS_ENV=development
# JWT signing key for access/refresh tokens. MUST be set in production so
# tokens survive restarts. Generate a strong key:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JARVIS_SECRET_KEY=
# The seeded "first login" admin signs in with this email.
# Development default (if JARVIS_ADMIN_EMAIL is omitted): admin@jarvis.local
JARVIS_ADMIN_EMAIL=admin@jarvis.local
# Password for the seeded admin account (used by start_all.ps1 at first boot).
# Never logged by the platform. Override or reset it immediately in production.
# JARVIS_ADMIN_PASSWORD=<set-a-strong-password-minimum-16-chars>

# --- GitHub (ext_id: github) ---
# OAuth App > Settings > Authorization callback URL:
#   http://localhost:8000/api/v1/extensions/oauth/callback/github
# Scopes requested: repo, read:user, read:org
JARVIS_OAUTH_GITHUB_CLIENT_ID=YOUR_GITHUB_APP_CLIENT_ID
JARVIS_OAUTH_GITHUB_CLIENT_SECRET=YOUR_GITHUB_APP_CLIENT_SECRET

# --- GitLab (ext_id: gitlab) ---
# Redirect URI: http://localhost:8000/api/v1/extensions/oauth/callback/gitlab
# Scopes requested: read_api, read_user
JARVIS_OAUTH_GITLAB_CLIENT_ID=YOUR_GITLAB_APP_CLIENT_ID
JARVIS_OAUTH_GITLAB_CLIENT_SECRET=YOUR_GITLAB_APP_CLIENT_SECRET

# --- Google Workspace (ext_id: google-workspace) ---
# OAuth consent screen + redirect URI:
#   http://localhost:8000/api/v1/extensions/oauth/callback/google-workspace
# Scopes requested: openid, email, profile, gmail.readonly, calendar.readonly, drive.metadata.readonly
JARVIS_OAUTH_GOOGLE_CLIENT_ID=YOUR_GOOGLE_OAUTH_CLIENT_ID
JARVIS_OAUTH_GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_OAUTH_CLIENT_SECRET

# --- Slack (ext_id: slack) ---
# App > OAuth & Permissions > Redirect URLs:
#   http://localhost:8000/api/v1/extensions/oauth/callback/slack
# Scopes requested: chat:write, channels:read, users:read
JARVIS_OAUTH_SLACK_CLIENT_ID=YOUR_SLACK_CLIENT_ID
JARVIS_OAUTH_SLACK_CLIENT_SECRET=YOUR_SLACK_CLIENT_SECRET

# --- API-key services (ext_ids: openai, claude, gemini, whisper, stablediffusion, codemuse) ---
#
# These services connect by an API key you create in the provider's own console
# (POST /extensions/<ext>/launch returns the console URL). At POST /connect the
# platform LIVE-validates the key against the provider's real API (no fake
# confirmation): a bad key -> 401, a valid key -> connected + capabilities go
# live on /capabilities.
#
# The key is looked up, in order, from:
#   (1) the JSON body {"api_key": "..."} you POST to /connect, or
#   (2) the first-set env var in each pair below.
#
# The validated key is injected into the platform process env (so the model
# gateway can use it immediately, no restart). The raw key is NEVER persisted
# to Jarvis KV -- only "validation":"verified" and "connected_by":"api_key"
# are. Create the key in the console linked from /launch and paste it here (or
# send it in the POST body).
OPENAI_API_KEY=
JARVIS_API_KEY_OPENAI=

ANTHROPIC_API_KEY=
JARVIS_API_KEY_CLAUDE=

GOOGLE_API_KEY=
JARVIS_API_KEY_GEMINI=

# HuggingFace token is shared by two extensions (Whisper + Stable Diffusion):
HF_TOKEN=
JARVIS_API_KEY_WHISPER=
JARVIS_API_KEY_STABLEDIFFUSION=

JARVIS_API_KEY_CODEMUSE=


# --- Connector OAuth: Gmail (connector kind: gmail, spec §7) ---
# Reuses the Google OAuth app above (JARVIS_OAUTH_GOOGLE_*). The SAME client_id
# powers both the Google Workspace extension and the Gmail connector, but each
# has its own redirect URI registered in the Google console:
#   http://localhost:8000/api/v1/connectors/oauth/callback/gmail
# Read-only first (gmail.readonly). To enable gmail.send / gmail.compose, re-run
# the authorize flow with the broader scope (the developer confirmation gate
# still guards every send/reply — spec §10/§34/§40).
# Scopes requested (read-only-first):
#   https://www.googleapis.com/auth/gmail.readonly
JARVIS_OAUTH_GOOGLE_CLIENT_ID=<same as above>

# --- Connector OAuth: Outlook / Microsoft 365 (connector kind: outlook, spec §8) ---
# Register a Microsoft identity-platform (v2.0) app (work or school account, or
# personal Microsoft account -> "common" tenant) and add this redirect URI:
#   http://localhost:8000/api/v1/connectors/oauth/callback/outlook
# Read-only first (Mail.Read). Enabling Mail.Send requires a re-consent, and the
# confirmation gate still covers every send/reply.
# Redirect URI to register in the Azure portal:
#   http://localhost:8000/api/v1/connectors/oauth/callback/outlook
# Scopes requested (read-only-first): Mail.Read
JARVIS_OAUTH_MICROSOFT_CLIENT_ID=YOUR_MICROSOFT_APP_CLIENT_ID
JARVIS_OAUTH_MICROSOFT_CLIENT_SECRET=YOUR_MICROSOFT_APP_CLIENT_SECRET
JARVIS_OAUTH_MICROSOFT_REDIRECT_URI=http://localhost:8000/api/v1/connectors/oauth/callback/outlook

# --- Automation engine: n8n (spec §33/§50) ---
# n8n is launched detached by start_all.ps1 on :5678 and is managed FROM this
# console (it is NOT a second admin platform). Workflows execute actions that
# JARVIS authorizes through the JARVIS tool API; n8n authenticates those
# callbacks with the JARVIS_API_KEY below and never holds provider OAuth tokens.
N8N_HOST=localhost
N8N_PORT=5678
N8N_ENCRYPTION_KEY=<generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())">
N8N_BASIC_AUTH_USER=jarvis
N8N_BASIC_AUTH_PASSWORD=<password n8n uses; also becomes the JARVIS_API_KEY below>
N8N_API_KEY=<optional; if set, n8n calls /api/v1/* with X-API-Key: this value>

# Platform-wide API key n8n (and automation nodes) use to call back into JARVIS.
# Mirrors N8N_BASIC_AUTH_PASSWORD by convention; start_all.ps1 passes this to n8n
# as JARVIS_API_KEY so workflows are authenticated at the tool boundary.
JARVIS_API_KEY=use-the-same-value-as-N8N_BASIC_AUTH_PASSWORD

# --- Remote JARVIS Brain (spec §5) ---
# Remote OpenAI-compatible Brain endpoint (NVIDIA NIM, or a GPU host serving
# Qwen3-4B / the SFT adapter). The JARVIS PC speaks to it over HTTP; model
# weights stay on the provider host. This key is a SECRET: loaded only through
# the platform secret vault (env / .env), never hardcoded, never returned by
# any /api route, never written to logs/telemetry/audit, and never sent to the
# browser. Set it in your local .env (NEVER commit a real value); in production
# inject it via the deployment secret manager / encrypted vault file.
JARVIS_BRAIN_ENDPOINT=
JARVIS_BRAIN_API_KEY=
# Designated Brain model (spec §7). For the NVIDIA-hosted Brain this is the
# live-verified NVIDIA default below; a local Qwen3-4B Brain would use its
# registry id instead. Never fabricate a model id that is not servable.
JARVIS_BRAIN_MODEL=nvidia/nemotron-3-ultra-550b-a55b

# --- JARVIS Provider Fabric (Phase 1) ---
# Multi-provider intelligence fabric: OpenAI, NVIDIA NIM, Google Vertex/Gemini,
# AWS Bedrock, Hugging Face, and local/remote models. Each adapter reads its
# credentials via the SecretManager (env -> .env -> encrypted vault). When a
# provider's credentials are absent, the adapter honestly reports
# "unconfigured" rather than failing — the fabric degrades gracefully.
#
# Routing priority (spec §35): comma-separated provider IDs that override the
# default best-quality scoring. No vendor is hard-coded as universally superior.
# Example: JARVIS_PROVIDER_PRIORITY=nvidia,openai,google,aws,hf
JARVIS_PROVIDER_PRIORITY=

# --- OpenAI (spec §6) ---
# Official OpenAI API server-side only. The key is never sent to the browser.
JARVIS_OPENAI_API_KEY=           # or reuse OPENAI_API_KEY above
JARVIS_OPENAI_MODEL=gpt-5        # model id from /v1/models discovery
JARVIS_OPENAI_BASE_URL=          # defaults to https://api.openai.com/v1
JARVIS_OPENAI_TIMEOUT=120

# --- NVIDIA NIM (spec §4, §5) ---
# Supports NVIDIA hosted inference, self-hosted NIM, and future NVIDIA cloud.
# The endpoint is NEVER assumed local. NVIDIA_API_KEY is accepted as an alias
# for JARVIS_NVIDIA_API_KEY (spec §33: Brain -> upstream credential).
# Only names verified against the live /v1/models catalog are used as defaults.
# nvidia/nemotron-3-ultra-550b-a55b is the documented default because it is
# invocable on a standard NVIDIA key (many advertised ids return 404
# "Function not found" unless the account is granted access to them).
NVIDIA_API_KEY=
JARVIS_NVIDIA_API_KEY=
JARVIS_NVIDIA_ENDPOINT=https://integrate.api.nvidia.com/v1
JARVIS_NVIDIA_MODEL=nvidia/nemotron-3-ultra-550b-a55b
JARVIS_NVIDIA_TIMEOUT=180

# --- Google Vertex AI / Gemini (spec §7) ---
# Either an API key (dev mode) or Vertex project + location (managed mode).
JARVIS_GOOGLE_API_KEY=           # or reuse GOOGLE_API_KEY above
JARVIS_GOOGLE_MODEL=gemini-2.5-pro
JARVIS_VERTEX_PROJECT_ID=
JARVIS_VERTEX_LOCATION=us-central1
JARVIS_VERTEX_MODEL=             # defaults to publishers/google/models/gemini-2.5-pro
JARVIS_GOOGLE_TIMEOUT=180

# --- AWS Bedrock (spec §8) ---
# Credentials honor boto3's standard chain (env/profile/SSO/federated).
# JARVIS_AWS_ACCESS_MODE: env (default) | profile | sso | federated
JARVIS_AWS_REGION=us-east-1
JARVIS_AWS_ACCESS_MODE=env
JARVIS_AWS_PROFILE=              # used when JARVIS_AWS_ACCESS_MODE=profile
JARVIS_AWS_MODEL=anthropic.claude-sonnet-4-5
JARVIS_AWS_TIMEOUT=180

# --- Hugging Face (spec §9) ---
# Token for registry/dataset/artifact access.  ``HUGGINGFACE_API_KEY`` is the
# canonical Brain-runtime name; ``HF_TOKEN`` and ``JARVIS_HF_TOKEN`` are accepted
# as transparent aliases (resolved by brain_runtime/env.py).
HUGGINGFACE_API_KEY=             # canonical (alias of HF_TOKEN / JARVIS_HF_TOKEN)
HF_TOKEN=
JARVIS_HF_TOKEN=                 # or reuse HF_TOKEN above
JARVIS_HF_INFERENCE_ENDPOINT=    # e.g. https://api-inference.huggingface.co/v1
JARVIS_HF_MODEL=                 # model id on the inference endpoint
JARVIS_HF_API_BASE=https://huggingface.co
JARVIS_HF_TIMEOUT=120

# --- JARVIS Brain runtime (spec §2, §5) ---
# The local Brain runtime (FastAPI on 127.0.0.1:8011) or a remote
# OpenAI-compatible endpoint (GPU host serving Qwen3-4B / SFT adapter).
# When JARVIS_BRAIN_BACKEND=remote, the fabric routes through the remote
# Brain; otherwise it uses the local runtime.
JARVIS_BRAIN_BACKEND=remote           # local | remote
JARVIS_BRAIN_ENDPOINT=http://127.0.0.1:8011/v1
# For an NVIDIA-hosted remote Brain, point the remote endpoint at
# https://integrate.api.nvidia.com/v1 and set JARVIS_BRAIN_REMOTE_API_KEY to
# the same value as JARVIS_NVIDIA_API_KEY (never a different credential).
JARVIS_BRAIN_REMOTE_ENDPOINT=       # remote OpenAI-compatible endpoint (Phase 1+)
JARVIS_BRAIN_REMOTE_API_KEY=        # key for the remote Brain endpoint
# When unset and the remote endpoint is NVIDIA-hosted, the remote model
# defaults to JARVIS_NVIDIA_MODEL (live-verified NVIDIA default).
JARVIS_BRAIN_REMOTE_MODEL=          # model id on the remote endpoint
# Silverwing local fallback (spec §50)
SILVERWING_ENDPOINT=http://127.0.0.1:8010

# --- Platform vault (optional, spec §16) ---
# Encrypted Fernet secret store. Set a strong key to enable vault persistence.
JARVIS_VAULT_PATH=                    # e.g. ./secrets/vault.json
JARVIS_VAULT_KEY=                     # 32-byte base64 key for Fernet encryption

# --- Unified Identity Layer (Phase 2, spec §12/§53/§54) ---
# OIDC login providers: Google, Microsoft, GitHub. Configure at least one to
# enable identity-provider login. The local JARVIS account (password) always
# works as a fallback. Credentials are loaded only through the SecretManager
# (env -> .env -> encrypted vault), never logged or returned by API routes.

# Google OIDC (spec §53)
JARVIS_GOOGLE_OIDC_CLIENT_ID=
JARVIS_GOOGLE_OIDC_CLIENT_SECRET=
JARVIS_GOOGLE_OIDC_REDIRECT_URI=http://localhost:8000/api/v1/identity/callback/google

# Microsoft Entra ID OIDC (spec §53)
JARVIS_MICROSOFT_OIDC_CLIENT_ID=
JARVIS_MICROSOFT_OIDC_CLIENT_SECRET=
JARVIS_MICROSOFT_OIDC_TENANT_ID=organizations
JARVIS_MICROSOFT_OIDC_REDIRECT_URI=http://localhost:8000/api/v1/identity/callback/microsoft

# GitHub OIDC (spec §53)
JARVIS_GITHUB_OIDC_CLIENT_ID=
JARVIS_GITHUB_OIDC_CLIENT_SECRET=
JARVIS_GITHUB_OIDC_REDIRECT_URI=http://localhost:8000/api/v1/identity/callback/github

# Identity session configuration (spec §54)
JARVIS_SESSION_ACCESS_TTL=900         # seconds; short-lived access tokens (15 min)
JARVIS_SESSION_REFRESH_TTL=2592000    # seconds; refresh token TTL (30 days)
JARVIS_LOGIN_MAX_ATTEMPTS=5           # per-IP before rate limiting
JARVIS_LOGIN_WINDOW=300               # rate-limit window in seconds
JARVIS_SESSION_COOKIE_SECURE=true     # set false for local HTTP testing only


# ──────────────────────────────────────────────────────────────────────────────
# Phase 5: NeMo Microservices Integration (spec §5, §31-§33)
# NeMo is OPTIONAL — never required for local operation.
# ┌─ Synthetic data / Fine-tuning / Evaluation / Safety / Guardrails ──────────
JARVIS_NEMO_API_KEY=
JARVIS_NEMO_ENDPOINT=https://api.nvidia.com/nemo/v1
JARVIS_NEMO_PROJECT_ID=
JARVIS_NEMO_REGION=us-central1
JARVIS_NEMO_TIMEOUT=120

# --- Provider credential aliases accepted by the tracked fabric (Phase 9) ---
# providers/control_center.py + jarvis_backend/runtime_status.py accept these
# aliases. Set ONE name per provider (values never logged or returned by API).
GEMINI_API_KEY=                  # alias accepted for GOOGLE_API_KEY / JARVIS_GOOGLE_API_KEY
# GOOGLE_APPLICATION_CREDENTIALS=C:\path\service-account.json   # Vertex AI ADC mode (file path, not a value)
HUGGING_FACE_HUB_TOKEN=          # alias accepted for HF_TOKEN / JARVIS_HF_TOKEN
# NVIDIA_API_TOKEN=              # alias accepted for NVIDIA_API_KEY / JARVIS_NVIDIA_API_KEY
# NIM_API_KEY=                   # alias accepted for NVIDIA_API_KEY / JARVIS_NVIDIA_API_KEY
# AWS env-mode credentials (boto3 standard chain; prefer SSO/role/*_FILE in production):
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

# --- Local / OpenAI-compatible model servers (silverwing-backend/model_provider.py) ---
# Selected when the matching *API_BASE/*HOST is set; keys stay server-side.
GROQ_API_KEY=
DEEPSEEK_API_KEY=
DEEPSEEK_API_BASE=               # OpenAI-compatible base URL for DeepSeek
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=                    # model id served by Ollama, e.g. llama3.1
LLAMACPP_API_BASE=http://127.0.0.1:8081/v1
VLLM_API_BASE=                   # e.g. http://127.0.0.1:8000/v1
VLLM_API_KEY=                    # local vLLM accepts any placeholder ("unused")
VLLM_MODEL=                      # model id served by vLLM

# --- Silverwing runtime bearer token (spec §27) ---
# Optional shared bearer clients must present to the Silverwing API (/v1/*).
# Empty = open on the loopback bind only; set it for any non-local exposure.
SILVERWING_API_KEY=

# --- Outbound mail transport (platform identity / connectors) ---
# Presence of SMTP_HOST/SMTP_USER derives the transport; no password belongs here.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
