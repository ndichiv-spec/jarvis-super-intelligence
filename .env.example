# JARVIS canonical configuration template (spec sections 23/24/54).
# Copy to .env and fill in values for your deployment. NEVER commit a real .env
# (this repository's .gitignore excludes .env). Values here are placeholders.

# --- Canonical host URLs (single source of truth for OAuth redirect URIs) ---
# The redirect URI the backend advertises is exactly:
#   $NEXT_PUBLIC_API_URL/api/v1/extensions/oauth/callback/<ext>
#   $NEXT_PUBLIC_API_URL/api/v1/connectors/oauth/callback/<kind>
# Register ONLY these URIs at each OAuth provider's console.
# Leave blank behind the production same-origin reverse proxy. For local
# development only, set this to the local API origin.
NEXT_PUBLIC_API_URL=

# --- Geography services (all optional; endpoints must use HTTPS) ---
# JARVIS_GEOCODER_URL=https://nominatim.openstreetmap.org/search
# JARVIS_GEOCODER_USER_AGENT=JARVIS/1.0 (contact: admin@example.org)
# JARVIS_ROUTING_URL=https://router.project-osrm.org/route/v1/driving
# JARVIS_MAP_TILE_URL=
# JARVIS_MAP_ATTRIBUTION=
# JARVIS_SATELLITE_IMAGERY_LICENSE_CONFIRMED=false
JARVIS_APP_URL=

# --- Required in production: stable Fernet/JWT signing secret ---
# Omit for local dev (an ephemeral per-restart key is generated). Set one in prod.
# JARVIS_SECRET_KEY=replace-with-64-hex-chars

# --- Environment + first-admin identity ---
# JARVIS_ENV=development
# JARVIS_ADMIN_EMAIL=admin@jarvis.local

# --- Provider API keys (Phase 6 provider fabric). The platform validates each
#     key LIVE against the provider before enabling its capabilities; never
#     commit real keys. OpenAI is the only pre-seeded provider. ---
OPENAI_API_KEY=
JARVIS_API_KEY_OPENAI=
ANTHROPIC_API_KEY=
JARVIS_API_KEY_CLAUDE=
GOOGLE_API_KEY=
JARVIS_API_KEY_GEMINI=
HF_TOKEN=
JARVIS_API_KEY_WHISPER=
JARVIS_API_KEY_STABLEDIFFUSION=
JARVIS_API_KEY_CODEMUSE=

# --- OAuth2 apps (JSON object keyed by provider). Each entry registers an
#     OAuth client so Connect runs a real authorize->callback->token exchange.
# Example:
# JARVIS_OAUTH_CLIENTS={"gmail":{"client_id":"...","client_secret":"...","authorize_url":"https://accounts.google.com/o/oauth2/v2/auth","token_url":"https://oauth2.googleapis.com/token","scope":"https://www.googleapis.com/auth/gmail.readonly","is_google":true},"outlook":{"client_id":"...","client_secret":"...","authorize_url":"https://login.microsoftonline.com/common/oauth2/v2.0/authorize","token_url":"https://login.microsoftonline.com/common/oauth2/v2.0/token","scope":"https://graph.microsoft.com/Mail.Read offline_access","is_microsoft":true}}

# --- AI backend wiring (local Silverwing model) ---
# SILVERWING_ENDPOINT=http://127.0.0.1:8010
# SILVERWING_MODEL=silverwing-120m-base-v1
# JARVIS_BRAIN_ENDPOINT=   (set only if you have a remote JARVIS BRAIN endpoint)

# --- Phase 15+ Backend Upgrade (Docker Compose / OTel / gRPC / MCP) ---
DB_HOST=postgres
DB_PORT=5432
DB_NAME=jarvis_db
DB_USER=jarvis
DB_PASSWORD=
REDIS_URL=redis://redis:6379/0
GRPC_HOST=0.0.0.0
GRPC_PORT=50051
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
SANDBOX_ENABLED=true
SANDBOX_BACKEND=auto

# --- Active Bio-Growth research worker ---
# Polls only the bundled seed feeds, persists research/knowledge items, and
# records run status. Set false to disable automatic polling; manual run remains
# available to administrators. The default poll is hourly.
JARVIS_BIO_GROWTH_WORKER_ENABLED=true
JARVIS_BIO_GROWTH_WORKER_MODE=embedded
JARVIS_BIO_GROWTH_POLL_SECONDS=3600

# --- Distributed worker queue ---
# The production Docker Compose stack points this at its isolated Redis queue.
# Local development can run the embedded scheduler without starting Celery.
# CELERY_BROKER_URL=redis://127.0.0.1:6379/1

# --- Outbound MCP services (optional) ---
# JARVIS connects only to explicitly listed services at backend startup.
# Credentials belong in environment variables referenced by headers_env, not URLs.
# MCP_SERVERS=[{"name":"work-tools","transport":"http","url":"https://mcp.example.net/mcp","headers_env":{"Authorization":"WORK_TOOLS_AUTH"}}]
# WORK_TOOLS_AUTH=Bearer replace-with-provider-token
# Command-based MCP servers execute local programs and are disabled by default.
# JARVIS_MCP_ALLOW_STDIO=false

# --- SMTP alert delivery (optional) ---
# Internal alert rules can use email when SMTP is configured. The external
# admin test endpoint remains disabled unless this flag is explicitly "true".
JARVIS_ALERT_EMAIL_EXTERNAL_NOTIFY=false
JARVIS_ALERT_EMAIL_SMTP_HOST=
JARVIS_ALERT_EMAIL_SMTP_PORT=587
JARVIS_ALERT_EMAIL_SMTP_USER=
JARVIS_ALERT_EMAIL_FROM=
JARVIS_ALERT_EMAIL_TO=
JARVIS_ALERT_EMAIL_USE_SSL=false
# Do not commit a real password. Inject JARVIS_ALERT_EMAIL_SMTP_PASSWORD through
# the runtime secret manager, or configure JARVIS_ALERT_EMAIL_SMTP_PASSWORD_FILE
# with a protected path visible to the backend process/container.
