# Copy to deployment/production/.env. Never commit the copy.
# Public hostname must have DNS A (and, if enabled, AAAA) records to the VPS.
DOMAIN=
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_WS_URL=
ACME_EMAIL=

POSTGRES_DB=jarvis
POSTGRES_USER=jarvis
JARVIS_ADMIN_EMAIL=

# Image generation is disabled until a provider key is provisioned.
# To enable it, select one provider and point the file source at its server-side
# API key. The file is mounted as a Docker secret and never placed in env values.
JARVIS_IMAGE_PROVIDER=
JARVIS_IMAGE_PROVIDER_KEY_FILE_SOURCE=

# Absolute paths to files provisioned outside the repository (0600 permissions).
# Generate URL-safe passwords (for example, openssl rand -hex 32).
POSTGRES_PASSWORD_FILE_SOURCE=/etc/jarvis/secrets/postgres-password
REDIS_PASSWORD_FILE_SOURCE=/etc/jarvis/secrets/redis-password
JARVIS_SECRET_KEY_FILE_SOURCE=/etc/jarvis/secrets/jarvis-secret-key
JARVIS_ADMIN_PASSWORD_FILE_SOURCE=/etc/jarvis/secrets/jarvis-admin-password
DATABASE_URL_FILE_SOURCE=/etc/jarvis/secrets/database-url
REDIS_URL_FILE_SOURCE=/etc/jarvis/secrets/redis-url

# A release job or operator should set immutable identifiers for each rollout.
JARVIS_VERSION=0.0.0
GIT_SHA=unknown
BUILD_TIME=unknown
DEPLOYMENT_ID=manual
