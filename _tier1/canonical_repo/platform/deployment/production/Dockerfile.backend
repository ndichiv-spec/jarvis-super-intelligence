FROM python:3.12.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    HOME=/tmp \
    XDG_CACHE_HOME=/tmp/cache

WORKDIR /app

RUN groupadd --system --gid 10001 jarvis \
    && useradd --system --uid 10001 --gid jarvis --home-dir /tmp jarvis \
    && mkdir -p /app/jarvis_data /app/jarvis_uploads \
    && chown -R jarvis:jarvis /app

COPY requirements-production.txt /tmp/requirements-production.txt
RUN pip install --no-cache-dir --upgrade pip \
    && pip install --no-cache-dir -r /tmp/requirements-production.txt

COPY --chown=jarvis:jarvis . /app

USER 10001:10001
EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=90s --retries=3 \
    CMD ["python", "-c", "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/health/live', timeout=3)"]

CMD ["uvicorn", "jarvis_backend.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1", "--timeout-graceful-shutdown", "30", "--proxy-headers", "--forwarded-allow-ips=*"]
